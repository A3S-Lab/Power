*.patch text eol=lf whitespace=-blank-at-eol
Cargo.lock text eol=lf

# Benchmark evidence carries byte-level SHA-256 identities. Preserve captured
# JSON, ACL, and prompt bytes across clones instead of applying autocrlf. Treat
# the immutable captures as evidence artifacts so line endings do not create
# misleading content diffs.
docs/benchmarks/qwen3.8-27b-q6k-rtx4090/*.json -text -diff
docs/benchmarks/qwen3.8-27b-q6k-rtx4090/*.acl -text -diff
docs/benchmarks/qwen3.8-27b-q6k-rtx4090/**/*.json -text -diff
docs/benchmarks/qwen3.8-27b-q6k-rtx4090/**/*.acl -text -diff
docs/benchmarks/qwen3.8-27b-q6k-rtx4090/prompt.txt -text
docs/benchmarks/tensor-batch-cost-windows-20260820/*.json -text -diff
docs/benchmarks/release-gate-windows-20260821/*.json -text -diff
