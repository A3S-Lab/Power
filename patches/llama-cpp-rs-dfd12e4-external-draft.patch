+
+struct llama_rs_external_draft_speculative {
+    common_params_speculative params;
+    common_speculative * spec = nullptr;
+    std::vector<llama_token> prompt;
+    std::vector<llama_token> draft;
+    size_t last_draft_len = 0;
+    bool draft_pending = false;
+};
+
+static bool llama_rs_external_draft_vocabs_compatible(
+    const llama_model * model_tgt,
+    const llama_model * model_dft) {
+    const llama_vocab * vocab_tgt = llama_model_get_vocab(model_tgt);
+    const llama_vocab * vocab_dft = llama_model_get_vocab(model_dft);
+    if (!vocab_tgt || !vocab_dft || llama_vocab_type(vocab_tgt) != llama_vocab_type(vocab_dft) ||
+        llama_vocab_get_add_bos(vocab_tgt) != llama_vocab_get_add_bos(vocab_dft) ||
+        llama_vocab_get_add_eos(vocab_tgt) != llama_vocab_get_add_eos(vocab_dft) ||
+        llama_vocab_bos(vocab_tgt) != llama_vocab_bos(vocab_dft) ||
+        llama_vocab_eos(vocab_tgt) != llama_vocab_eos(vocab_dft)) {
+        return false;
+    }
+    const int32_t n_tgt = llama_vocab_n_tokens(vocab_tgt);
+    const int32_t n_dft = llama_vocab_n_tokens(vocab_dft);
+    if (n_tgt <= 0 || n_tgt != n_dft) {
+        return false;
+    }
+    for (int32_t token = 0; token < n_tgt; ++token) {
+        const char * tgt = llama_vocab_get_text(vocab_tgt, token);
+        const char * dft = llama_vocab_get_text(vocab_dft, token);
+        if (!tgt || !dft || std::strcmp(tgt, dft) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool llama_rs_external_draft_geometry_compatible(
+    const llama_context * ctx_tgt,
+    const llama_context * ctx_dft,
+    int32_t kind,
+    int32_t n_max,
+    int32_t n_min) {
+    if (kind != 1 && kind != 2) {
+        return false;
+    }
+    const llama_model * model_tgt = llama_get_model(ctx_tgt);
+    const llama_model * model_dft = llama_get_model(ctx_dft);
+    if (!model_tgt || !model_dft || !llama_rs_external_draft_vocabs_compatible(model_tgt, model_dft)) {
+        return false;
+    }
+    char architecture[32] = {};
+    if (llama_model_meta_val_str(model_dft, "general.architecture", architecture, sizeof(architecture)) < 0 ||
+        std::strcmp(architecture, "dflash") != 0) {
+        return false;
+    }
+    const int32_t * layers = llama_model_target_layer_ids(model_dft);
+    const uint32_t n_layers = llama_model_target_layer_ids_n(model_dft);
+    const int32_t target_layer_count = llama_model_n_layer(model_tgt);
+    if (!layers || n_layers == 0 || target_layer_count <= 0) {
+        return false;
+    }
+    for (uint32_t index = 0; index < n_layers; ++index) {
+        if (layers[index] < 0 || layers[index] >= target_layer_count) {
+            return false;
+        }
+    }
+    char block_size_text[32] = {};
+    if (llama_model_meta_val_str(model_dft, "dflash.block_size", block_size_text, sizeof(block_size_text)) < 0) {
+        return false;
+    }
+    const int32_t block_size = std::atoi(block_size_text);
+    const int32_t maximum = kind == 2 ? block_size : block_size - 1;
+    return block_size > 1 && n_max <= maximum && n_min <= maximum;
+}
+
+extern "C" struct llama_rs_external_draft_speculative * llama_rs_external_draft_speculative_init(
+    struct llama_context * ctx_tgt,
+    struct llama_context * ctx_dft,
+    int32_t kind,
+    int32_t n_max,
+    int32_t n_min,
+    float p_min) {
+    if (!ctx_tgt || !ctx_dft || n_max <= 0 || n_min < 0 || n_min > n_max ||
+        !std::isfinite(p_min) || p_min < 0.0f || p_min > 1.0f ||
+        !llama_rs_external_draft_geometry_compatible(ctx_tgt, ctx_dft, kind, n_max, n_min)) {
+        return nullptr;
+    }
+    try {
+        auto wrapper = std::make_unique<llama_rs_external_draft_speculative>();
+        wrapper->params.types = {
+            kind == 2 ? COMMON_SPECULATIVE_TYPE_DRAFT_DSPARK : COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH,
+        };
+        wrapper->params.draft.ctx_tgt = ctx_tgt;
+        wrapper->params.draft.ctx_dft = ctx_dft;
+        wrapper->params.draft.n_max = n_max;
+        wrapper->params.draft.n_min = n_min;
+        wrapper->params.draft.p_min = p_min;
+        wrapper->spec = common_speculative_init(wrapper->params, 1);
+        if (!wrapper->spec) {
+            return nullptr;
+        }
+        return wrapper.release();
+    } catch (...) {
+        return nullptr;
+    }
+}
+
+extern "C" void llama_rs_external_draft_speculative_free(
+    struct llama_rs_external_draft_speculative * spec) {
+    if (!spec) {
+        return;
+    }
+    if (spec->spec) {
+        common_speculative_free(spec->spec);
+        spec->spec = nullptr;
+    }
+    delete spec;
+}
+
+extern "C" llama_rs_status llama_rs_external_draft_speculative_begin(
+    struct llama_rs_external_draft_speculative * spec,
+    const llama_token * prompt_tokens,
+    size_t prompt_tokens_count) {
+    if (!spec || !spec->spec || (!prompt_tokens && prompt_tokens_count > 0)) {
+        return LLAMA_RS_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        llama_rs_assign_tokens(spec->prompt, prompt_tokens, prompt_tokens_count);
+        spec->last_draft_len = 0;
+        spec->draft_pending = false;
+        common_speculative_begin(spec->spec, LLAMA_RS_MTP_SEQ_ID, spec->prompt);
+        return LLAMA_RS_STATUS_OK;
+    } catch (...) {
+        return LLAMA_RS_STATUS_EXCEPTION;
+    }
+}
+
+extern "C" llama_rs_status llama_rs_external_draft_speculative_process(
+    struct llama_rs_external_draft_speculative * spec,
+    const struct llama_batch * batch) {
+    if (!spec || !spec->spec || !batch || !llama_rs_mtp_batch_compatible(*batch)) {
+        return LLAMA_RS_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        return common_speculative_process(spec->spec, *batch)
+            ? LLAMA_RS_STATUS_OK
+            : LLAMA_RS_STATUS_EXCEPTION;
+    } catch (...) {
+        return LLAMA_RS_STATUS_EXCEPTION;
+    }
+}
+
+extern "C" llama_rs_status llama_rs_external_draft_speculative_draft(
+    struct llama_rs_external_draft_speculative * spec,
+    llama_pos n_past,
+    llama_token id_last,
+    size_t max_draft_tokens,
+    const llama_token * prompt_tokens,
+    size_t prompt_tokens_count,
+    llama_token * out_tokens,
+    size_t out_tokens_capacity,
+    size_t * out_tokens_count) {
+    if (!spec || !spec->spec || spec->draft_pending || max_draft_tokens == 0 ||
+        max_draft_tokens > static_cast<size_t>(spec->params.draft.n_max) ||
+        (!prompt_tokens && prompt_tokens_count > 0) || !out_tokens_count || n_past < 0) {
+        return LLAMA_RS_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        llama_rs_assign_tokens(spec->prompt, prompt_tokens, prompt_tokens_count);
+        spec->draft.clear();
+        spec->last_draft_len = 0;
+        auto & params = common_speculative_get_draft_params(spec->spec, LLAMA_RS_MTP_SEQ_ID);
+        params = {
+            true,
+            static_cast<int32_t>(max_draft_tokens),
+            n_past,
+            id_last,
+            &spec->prompt,
+            &spec->draft,
+        };
+        common_speculative_draft(spec->spec);
+        *out_tokens_count = spec->draft.size();
+        if (spec->draft.size() > out_tokens_capacity) {
+            return LLAMA_RS_STATUS_ALLOCATION_FAILED;
+        }
+        if (!spec->draft.empty() && !out_tokens) {
+            return LLAMA_RS_STATUS_INVALID_ARGUMENT;
+        }
+        if (!spec->draft.empty()) {
+            std::memcpy(out_tokens, spec->draft.data(), spec->draft.size() * sizeof(llama_token));
+        }
+        spec->last_draft_len = spec->draft.size();
+        spec->draft_pending = !spec->draft.empty();
+        return LLAMA_RS_STATUS_OK;
+    } catch (...) {
+        return LLAMA_RS_STATUS_EXCEPTION;
+    }
+}
+
+extern "C" llama_rs_status llama_rs_external_draft_speculative_accept(
+    struct llama_rs_external_draft_speculative * spec,
+    uint16_t n_accepted) {
+    if (!spec || !spec->spec || !spec->draft_pending || n_accepted > spec->last_draft_len) {
+        return LLAMA_RS_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        common_speculative_accept(spec->spec, LLAMA_RS_MTP_SEQ_ID, n_accepted);
+        spec->last_draft_len = 0;
+        spec->draft_pending = false;
+        return LLAMA_RS_STATUS_OK;
+    } catch (...) {
+        return LLAMA_RS_STATUS_EXCEPTION;
+    }
+}
