+/// Decoder implemented by an external DFlash-family draft model.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(i32)]
+pub enum ExternalDraftSpeculativeKind {
+    /// DFlash block-diffusion decoding.
+    Dflash = 1,
+    /// DSpark anchor-first decoding with a Markov head.
+    Dspark = 2,
+}
+
+/// Parameters for external DFlash-family speculative decoding.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ExternalDraftSpeculativeParams {
+    /// Decoder contract carried by the artifact manifest.
+    pub kind: ExternalDraftSpeculativeKind,
+    /// Maximum number of draft tokens to propose.
+    pub n_max: i32,
+    /// Minimum number of draft tokens required before returning a draft.
+    pub n_min: i32,
+    /// Minimum confidence accepted by the trained draft head.
+    pub p_min: f32,
+}
+
+/// Errors returned by the external-draft speculative wrapper.
+#[derive(Debug, Eq, PartialEq, thiserror::Error)]
+pub enum ExternalDraftSpeculativeError {
+    /// Invalid parameters were provided.
+    #[error("invalid external-draft speculative parameters")]
+    InvalidParams,
+    /// llama.cpp rejected the target/draft model pair or decoder contract.
+    #[error("llama.cpp failed to initialize external-draft speculative decoding")]
+    InitFailed,
+    /// llama.cpp rejected a wrapper call.
+    #[error("llama.cpp external-draft speculative call failed with status {0}")]
+    Status(i32),
+    /// The draft output exceeded the caller-provided bound.
+    #[error("llama.cpp external draft exceeded configured maximum")]
+    DraftOverflow,
+}
+
+/// RAII owner for one external DFlash-family speculative context.
+#[derive(Debug)]
+pub struct ExternalDraftSpeculative<'target, 'draft> {
+    raw: NonNull<llama_cpp_sys_2::llama_rs_external_draft_speculative>,
+    target_context: LlamaContext<'target>,
+    draft_context: LlamaContext<'draft>,
+    n_max: usize,
+}
+
+impl<'target, 'draft> ExternalDraftSpeculative<'target, 'draft> {
+    /// Bind target and independently loaded draft contexts.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when parameters, vocabularies, tensor geometry, or the
+    /// declared decoder contract are incompatible.
+    pub fn new(
+        target_context: LlamaContext<'target>,
+        draft_context: LlamaContext<'draft>,
+        params: ExternalDraftSpeculativeParams,
+    ) -> Result<Self, ExternalDraftSpeculativeError> {
+        if params.n_max <= 0
+            || params.n_min < 0
+            || params.n_min > params.n_max
+            || !params.p_min.is_finite()
+            || !(0.0..=1.0).contains(&params.p_min)
+        {
+            return Err(ExternalDraftSpeculativeError::InvalidParams);
+        }
+        let n_max = usize::try_from(params.n_max)
+            .map_err(|_| ExternalDraftSpeculativeError::InvalidParams)?;
+        let raw = unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_init(
+                target_context.context.as_ptr(),
+                draft_context.context.as_ptr(),
+                params.kind as i32,
+                params.n_max,
+                params.n_min,
+                params.p_min,
+            )
+        };
+        let raw = NonNull::new(raw).ok_or(ExternalDraftSpeculativeError::InitFailed)?;
+        Ok(Self {
+            raw,
+            target_context,
+            draft_context,
+            n_max,
+        })
+    }
+
+    /// Access the target context.
+    #[must_use]
+    pub fn target_context(&self) -> &LlamaContext<'target> {
+        &self.target_context
+    }
+
+    /// Access the target context for decode and rollback operations.
+    pub fn target_context_mut(&mut self) -> &mut LlamaContext<'target> {
+        &mut self.target_context
+    }
+
+    /// Access the draft context for rollback operations.
+    pub fn draft_context_mut(&mut self) -> &mut LlamaContext<'draft> {
+        &mut self.draft_context
+    }
+
+    /// Begin a new generation from the given prompt tokens.
+    pub fn begin(
+        &mut self,
+        prompt_tokens: &[LlamaToken],
+    ) -> Result<(), ExternalDraftSpeculativeError> {
+        let prompt = tokens_to_raw(prompt_tokens);
+        let status = unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_begin(
+                self.raw.as_ptr(),
+                prompt.as_ptr(),
+                prompt.len(),
+            )
+        };
+        external_status_to_result(status)
+    }
+
+    /// Synchronize draft state from a target batch that was just decoded.
+    pub fn process(&mut self, batch: &LlamaBatch<'_>) -> Result<(), ExternalDraftSpeculativeError> {
+        let status = unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_process(
+                self.raw.as_ptr(),
+                std::ptr::from_ref(&batch.llama_batch),
+            )
+        };
+        external_status_to_result(status)
+    }
+
+    /// Generate at most `max_draft` proposals after `id_last`.
+    pub fn draft_with_max(
+        &mut self,
+        n_past: i32,
+        id_last: LlamaToken,
+        prompt_tokens: &[LlamaToken],
+        max_draft: usize,
+    ) -> Result<Vec<LlamaToken>, ExternalDraftSpeculativeError> {
+        if n_past < 0 || max_draft == 0 || max_draft > self.n_max {
+            return Err(ExternalDraftSpeculativeError::InvalidParams);
+        }
+        let prompt = tokens_to_raw(prompt_tokens);
+        let mut raw_out = vec![0; max_draft];
+        let mut out_len = 0_usize;
+        let status = unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_draft(
+                self.raw.as_ptr(),
+                n_past,
+                id_last.0,
+                max_draft,
+                prompt.as_ptr(),
+                prompt.len(),
+                raw_out.as_mut_ptr(),
+                raw_out.len(),
+                &raw mut out_len,
+            )
+        };
+        if status == llama_cpp_sys_2::LLAMA_RS_STATUS_ALLOCATION_FAILED {
+            return Err(ExternalDraftSpeculativeError::DraftOverflow);
+        }
+        external_status_to_result(status)?;
+        raw_out.truncate(out_len);
+        Ok(raw_out.into_iter().map(LlamaToken).collect())
+    }
+
+    /// Commit the accepted proposal prefix.
+    pub fn accept(&mut self, n_accepted: u16) -> Result<(), ExternalDraftSpeculativeError> {
+        let status = unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_accept(
+                self.raw.as_ptr(),
+                n_accepted,
+            )
+        };
+        external_status_to_result(status)
+    }
+}
+
+impl Drop for ExternalDraftSpeculative<'_, '_> {
+    fn drop(&mut self) {
+        unsafe {
+            llama_cpp_sys_2::llama_rs_external_draft_speculative_free(self.raw.as_ptr());
+        }
+    }
+}
+
 fn tokens_to_raw(tokens: &[LlamaToken]) -> Vec<llama_cpp_sys_2::llama_token> {
     tokens.iter().map(|token| token.0).collect()
 }
@@ -253,3 +441,13 @@ fn status_to_result(status: llama_cpp_sys_2::llama_rs_status) -> Result<(), MtpS
         Err(MtpSpeculativeError::Status(status as i32))
     }
 }
+
+fn external_status_to_result(
+    status: llama_cpp_sys_2::llama_rs_status,
+) -> Result<(), ExternalDraftSpeculativeError> {
+    if status_is_ok(status) {
+        Ok(())
+    } else {
+        Err(ExternalDraftSpeculativeError::Status(status as i32))
+    }
+}
