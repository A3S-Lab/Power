+int32_t llama_context::mtp_recurrent_end(llama_token * tokens_out, size_t capacity) {
+    if (mtp_recurrent_active) {
+        synchronize();
+    }
+
+    const size_t n_tokens = mtp_recurrent_token_count;
+    const bool output_valid = n_tokens <= capacity && (n_tokens == 0 || tokens_out != nullptr);
+    if (output_valid && n_tokens > 0) {
+        std::memcpy(tokens_out, mtp_recurrent_tokens_host, n_tokens * sizeof(llama_token));
+    }
+
+    mtp_recurrent_active = false;
+    mtp_recurrent_input_pending = false;
+    mtp_recurrent_token_host = nullptr;
+    mtp_recurrent_token_count = 0;
+    ggml_backend_sched_clear_input_copy_overrides(sched.get());
+
+    return output_valid ? (int32_t) n_tokens : -1;
+}
