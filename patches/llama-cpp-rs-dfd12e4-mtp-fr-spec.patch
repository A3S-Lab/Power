+struct ggml_tensor * ggml_backend_sched_get_tensor_copy(
+        ggml_backend_sched_t sched, struct ggml_tensor * node, ggml_backend_t backend) {
+    GGML_ASSERT(sched);
+    if (!node || !backend || !ggml_hash_contains(&sched->hash_set, node)) {
+        return NULL;
+    }
+
+    const int backend_id = ggml_backend_sched_backend_id(sched, backend);
+    if (backend_id < 0 || backend_id >= sched->n_backends) {
+        return NULL;
+    }
+
+    const size_t node_id = ggml_hash_find(&sched->hash_set, node);
+    GGML_ASSERT(node_id != GGML_HASHSET_FULL);
+    struct ggml_tensor * copy = tensor_id_copy(node_id, backend_id, sched->cur_copy);
+    if (copy != NULL) {
+        return copy;
+    }
+
+    return sched->hv_tensor_backend_ids[node_id] == backend_id ? node : NULL;
+}
+
+bool ggml_backend_sched_override_input_copy(
+        ggml_backend_sched_t sched, struct ggml_tensor * input, ggml_backend_t backend) {
+    GGML_ASSERT(sched);
+    if (!input || !(input->flags & GGML_TENSOR_FLAG_INPUT) ||
+            ggml_backend_sched_get_tensor_copy(sched, input, backend) == NULL) {
+        return false;
+    }
+
+    const int backend_id = ggml_backend_sched_backend_id(sched, backend);
+    if (ggml_backend_sched_input_copy_is_overridden(sched, input, backend_id)) {
+        return true;
+    }
+    if (sched->n_input_copy_overrides >= GGML_SCHED_MAX_INPUT_COPY_OVERRIDES) {
+        return false;
+    }
+
+    sched->input_copy_overrides[sched->n_input_copy_overrides++] = { input, backend_id };
+    return true;
+}
+
+void ggml_backend_sched_clear_input_copy_overrides(ggml_backend_sched_t sched) {
