+bool llama_context::mtp_recurrent_begin(uint32_t max_steps) {
+    if (mtp_recurrent_active || mtp_recurrent_input_pending ||
+            cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+            model.arch != LLM_ARCH_QWEN35 || model.hparams.n_layer_nextn != 1 ||
+            cparams.pipeline_parallel || graph_reuse_disable ||
+            sampling.samplers.size() != 1 || max_steps == 0 || max_steps > 64) {
+        return false;
+    }
+
+    auto * output_dev = model.dev_output();
+    auto * host_buft = output_dev ? ggml_backend_dev_host_buffer_type(output_dev) : nullptr;
+    if (host_buft == nullptr) {
+        return false;
+    }
+
+    const size_t token_bytes = (size_t) max_steps * sizeof(llama_token);
+    const size_t hidden_bytes = (size_t) model.hparams.n_embd_out() * sizeof(float);
+    const size_t required_bytes = token_bytes + hidden_bytes;
+    if (!buf_mtp_recurrent || ggml_backend_buffer_get_size(buf_mtp_recurrent.get()) < required_bytes) {
+        buf_mtp_recurrent.reset(ggml_backend_buft_alloc_buffer(host_buft, required_bytes));
+        if (!buf_mtp_recurrent) {
+            return false;
+        }
+    }
+
+    auto * base = (uint8_t *) ggml_backend_buffer_get_base(buf_mtp_recurrent.get());
+    mtp_recurrent_tokens_host = (llama_token *) base;
+    mtp_recurrent_h_host = (float *) (base + token_bytes);
+    mtp_recurrent_token_capacity = max_steps;
+    mtp_recurrent_token_count = 0;
+    mtp_recurrent_token_host = nullptr;
+    mtp_recurrent_active = true;
+    return true;
+}
