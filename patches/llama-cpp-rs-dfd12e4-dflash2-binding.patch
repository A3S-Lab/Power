+static bool llama_rs_positive_model_meta(
+    const llama_model * model,
+    const char * key,
+    int32_t * value = nullptr) {
+    char text[32] = {};
+    if (llama_model_meta_val_str(model, key, text, sizeof(text)) < 0) {
+        return false;
+    }
+    char * end = nullptr;
+    const long parsed = std::strtol(text, &end, 10);
+    if (end == text || *end != '\0' || parsed <= 0 || parsed > INT32_MAX) {
+        return false;
+    }
+    if (value) {
+        *value = static_cast<int32_t>(parsed);
+    }
+    return true;
+}
